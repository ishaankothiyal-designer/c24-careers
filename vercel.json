{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/**/*.js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/builders/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/careers/:path*",
      "destination": "/index.html"
    }
  ]
}
